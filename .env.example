MYSITE=www.my-domain.com
HY2_ADDR=":10443"
HY2_PASSWORD=123

# WARP SOCKS5 address for Hysteria 2 traffic splitting (Google Gemini / ChatGPT unlock)
# To disable WARP routing, comment out the relevant ACL rules in config.toml after generation.
HY2_WARP_ADDR=127.0.0.1:40000
XRAY_UUID=123
XRAY_VLESS_PORT=443
XRAY_TARGET=www.microsoft.com:443
XRAY_SERVERNAMES="www.microsoft.com","microsoft.com"
XRAY_SHORTIDS="aabbccdd","ffee5678"
XRAY_REALITY_PRIVATE_KEY=123
XRAY_REALITY_MLDSA65_SEED=456

XRAY_IMAGE=ghcr.io/xtls/xray-core:26.1.13
NGINX_IMAGE=nginx:latest
HY2_IMAGE=tobyxdd/hysteria:v2.9.2
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:1.13.12

SINGBOX_TUIC_PORT=20443
SINGBOX_TUIC_UUID=123
SINGBOX_TUIC_PASSWORD=123

# sing-box AnyTLS
SINGBOX_ANYTLS_PORT=24443
SINGBOX_ANYTLS_USERNAME=anytls_user
SINGBOX_ANYTLS_PASSWORD=your-strong-password


# WARP SOCKS5 settings for sing-box traffic splitting (Google Gemini / ChatGPT unlock)
# Set to empty to disable WARP routing.
SINGBOX_WARP_SERVER=127.0.0.1
SINGBOX_WARP_PORT=40000

# =============================================================================
# mosdns (self-hosted anti-pollution DNS, optional)
# =============================================================================
# DoH 监听端口，客户端 REMOTE_DNS 填 https://<MYSITE>:<this>/dns-query
MOSDNS_DOH_PORT=8443
# DoT 监听端口，客户端也可用 tls://<MYSITE>:<this>
MOSDNS_DOT_PORT=853
# mosdns 递归查询的上游（DoH）。服务器在境外，天然防污染。
MOSDNS_UPSTREAM_PRIMARY=https://1.1.1.1/dns-query
MOSDNS_UPSTREAM_SECONDARY=https://dns.google/dns-query
MOSDNS_IMAGE=irinesistiana/mosdns:v5.3.4

# =============================================================================
# Binary download URLs (used by systemd mode on low-end VPS without Docker)
# Set to empty to skip installing that binary.
# =============================================================================
# Xray: usually a .zip file, e.g. Xray-linux-64.zip
XRAY_DOWNLOAD_URL=https://github.com/XTLS/Xray-core/releases/download/v26.1.13/Xray-linux-64.zip

# Hysteria 2: usually a raw binary, e.g. hysteria-linux-amd64
HY2_DOWNLOAD_URL=https://github.com/apernet/hysteria/releases/download/app/v2.9.2/hysteria-linux-amd64

# sing-box: usually a .tar.gz file
SINGBOX_DOWNLOAD_URL=https://github.com/Sagernet/sing-box/releases/download/v1.13.12/sing-box-1.13.12-linux-amd64.tar.gz

# mosdns: usually a .zip file
MOSDNS_DOWNLOAD_URL=https://github.com/IrineSistiana/mosdns/releases/download/v5.3.4/mosdns-linux-amd64.zip

