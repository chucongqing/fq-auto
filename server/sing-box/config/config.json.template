{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "tuic",
      "tag": "tuic-in",
      "listen": "::",
      "listen_port": 0,
      "users": [
        {
          "uuid": "",
          "password": ""
        }
      ],
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "server_name": "",
        "alpn": [
          "h3"
        ],
        "certificate_path": "/etc/ssl/cert.pem",
        "key_path": "/etc/ssl/key.pem"
      }
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": 0,
      "users": [
        {
          "name": "",
          "password": ""
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "",
        "certificate_path": "/etc/ssl/cert.pem",
        "key_path": "/etc/ssl/key.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "warp",
      "server": "",
      "server_port": 0
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain_suffix": [
          "google.com",
          "googleapis.com",
          "googleusercontent.com",
          "gstatic.com",
          "gvt1.com",
          "gvt2.com",
          "gvt3.com",
          "ggpht.com",
          "android.com"
        ],
        "action": "route",
        "outbound": "warp"
      },
      {
        "domain_suffix": [
          "openai.com",
          "chatgpt.com"
        ],
        "action": "route",
        "outbound": "warp"
      }
    ],
    "final": "direct"
  }
}
